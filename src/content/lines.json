    "start_music_2": {"who": "frost", "say": ["这是", {"w": "music"}, "楼梯。踩一级，就唱一个音。"]},
    "start_music_3": {"who": "nuan", "say": [{"w": "red"}, "像我的小灯笼，", {"w": "yellow"}, "像星星，", {"w": "blue"}, "像你的冰。"]},
    "start_music_4": {"who": "frost", "say": ["我先弹一遍，亮起来的台阶，你跟着踩。踩错了也没关系。"]},
    "start_ballroom_1": {"who": "nuan", "say": ["姐姐，快看！这里有好多", {"w": "ball"}, "，大雪球！"]},
    "start_ballroom_2": {"who": "frost", "say": ["我们把它们堆起来，变成", {"w": "snowman"}, "吧。"]},
