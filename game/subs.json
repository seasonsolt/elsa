":"companion","comp":true,"s":[["掉进",0],["water",1],["也没关系，再试一次吧。",0]]},"idle_1":{"who":"companion","comp":true,"s":[["你在看什么呀？",0]]},"idle_2":{"who":"companion","comp":true,"s":[["要不要去那边看看？",0]]},"idle_3":{"who":"companion","comp":true,"s":[["点一点右上角的小灯泡，我就告诉你。",0]]},"idle_4":{"who":"companion","comp":true,"s":[["慢慢来，不着急。",0]]},"miss_frost":{"who":"nuan","comp":false,"s":[["姐姐，你在哪儿呀？",0]]},"miss_nuan":{"who":"frost","comp":false,"s":[["安娜，你在哪儿呀？",0]]},"together_1":{"who":"nuan","comp":false,"s":[["Yay!",1],["我们在一起啦！",0]],"w":[["耶！",0],["我们在一起啦！",0]]},"together_2":{"who":"frost","comp":false,"s":[["和你在一起，真暖和。",0]]},"mem_m1":{"who":"narrator","comp":false,"s":[["每天，安娜都画一幅画，从门缝里塞给姐姐。画里是她们俩，还有红围巾雪人。艾莎把画一张张收好，偷偷笑了。",0]]},"mem_m3":{"who":"narrator","comp":false,"s":[["小时候，艾莎把湖面冻成一面大镜子。姐妹俩手拉手，滑呀滑，一直滑到星星出来。",0]]},"mem_m5":{"who":"narrator","comp":false,"s":[["冬天，艾莎在雪坡上冻出一条长长的冰滑梯。安娜坐着小木盆呼地滑下去，笑声一路飞到山脚。",0]]},"mem_m2":{"who":"narrator","comp":false,"s":[["艾莎偷偷给妹妹织了一条红围巾。织呀织，她一边织一边笑，想着安娜收到时的样子。",0]]},"mem_m6":{"who":"narrator","comp":false,"s":[["安娜想摸摸天上的星星，可是够不着。艾莎堆了一张软软的雪床，安娜一跳，弹得高高的，好像真的摸到了星星。",0]]},"mem_m7":{"who":"narrator","comp":false,"s":[["下雪天，她们在门口捡到一只小雪兔。安娜用小灯笼给它暖身子，艾莎用冰做了个小窝，它就睡着了。",0]]},"mem_m8":{"who":"narrator","comp":false,"s":[["有一年冬天，河面上漂着一块块浮冰。艾莎让一块停下来，姐妹俩坐上去，慢慢漂，一边漂一边数小鱼。",0]]},"mem_m9":{"who":"narrator","comp":false,"s":[["艾莎用薄薄的冰片做了一串小风铃。安娜轻轻一碰，叮叮咚咚，她就跟着哼起歌来，艾莎听着听着，笑了。",0]]},"mem_m4":{"who":"narrator","comp":false,"s":[["有一天，她们打雪仗，打得太开心了。雪球越滚越大，扑通，两个人一起摔进雪堆，哈哈大笑。",0]]},"mem_m10":{"who":"narrator","comp":false,"s":[["小时候最后一场雪里，她们在花园堆了第一个雪人，给它戴上一朵小花。安娜说，明年还要一起堆。",0]]},"me_frost":{"who":"frost","comp":false,"s":[["Hello!",1],["我是艾莎。我最喜欢蓝色，还有亮晶晶的",0],["snowflake",1],["。我会变出冰，铺成小路。我的小秘密是，我睡觉的时候，会抱着一只小雪兔玩偶。",0]],"w":[["你好！",0],["我是艾莎。我最喜欢蓝色，还有亮晶晶的",0],["snowflake",1],["。我会变出冰，铺成小路。我的小秘密是，我睡觉的时候，会抱着一只小雪兔玩偶。",0]]},"me_nuan":{"who":"nuan","comp":false,"s":[["Hello!",1],["我是安娜。我最喜欢红色，还有圆圆的小灯笼。灯笼暖烘烘的，能让冰变软。我的小秘密是，我最爱吃热乎乎的烤红薯，吃的时候会偷偷哼歌。",0]],"w":[["你好！",0],["我是安娜。我最喜欢红色，还有圆圆的小灯笼。灯笼暖烘烘的，能让冰变软。我的小秘密是，我最爱吃热乎乎的烤红薯，吃的时候会偷偷哼歌。",0]]},"win":{"who":"narrator","comp":false,"s":[["Yay!",1],["花园里开满了花！姐妹俩手拉着手，开心地转圈圈。",0]],"w":[["耶！",0],["花园里开满了花！姐妹俩手拉着手，开心地转圈圈。",0]]},"end":{"who":"narrator","comp":false,"s":[["sun",1],["出来啦！冰花都开成了真正的小花，",0],["spring",1],["回来了。小时候的雪人戴着帽子，笑眯眯地站在花丛里。艾莎不再害羞，她牵着安娜的手，笑着和大家说",0],["Hello!",1]],"w":[["sun",1],["出来啦！冰花都开成了真正的小花，",0],["spring",1],["回来了。小时候的雪人戴着帽子，笑眯眯地站在花丛里。艾莎不再害羞，她牵着安娜的手，笑着和大家说",0],["你好！",0]]},"ui_start":{"who":"narrator","comp":false,"s":[["开始玩",0]]},"ui_continue":{"who":"narrator","comp":false,"s":[["继续玩",0]]},"ui_next":{"who":"narrator","comp":false,"s":[["下一个",0]]},"ui_replay":{"who":"narrator","comp":false,"s":[["再玩一次",0]]},"ui_back":{"who":"narrator","comp":false,"s":[["回去",0]]},"ui_words":{"who":"narrator","comp":false,"s":[["单词本",0]]},"ui_stickers":{"who":"narrator","comp":false,"s":[["贴纸本",0]]},"ui_wardrobe":{"who":"narrator","comp":false,"s":[["换衣服",0]]},"ui_settings":{"who":"narrator","comp":false,"s":[["家长设置",0]]},"ui_hint":{"who":"narrator","comp":false,"s":[["小提示",0]]},"ui_fullscreen":{"who":"narrator","comp":false,"s":[["全屏",0]]},"ui_swap":{"who":"narrator","comp":false,"s":[["换一换",0]]},"ui_solo":{"who":"narrator","comp":false,"s":[["一个人玩",0]]},"ui_duo":{"who":"narrator","comp":false,"s":[["两个人玩",0]]},"ui_sound":{"who":"narrator","comp":false,"s":[["声音",0]]},"ui_quiz_skip":{"who":"narrator","comp":false,"s":[["跳过",0]]},"ui_meet":{"who":"narrator","comp":false,"s":[["认识她们",0]]},"ui_rooms":{"who":"narrator","comp":false,"s":[["房间",0]]},"ui_room_hall":{"who":"narrator","comp":false,"s":[["冰堡大厅",0]]},"ui_room_lake":{"who":"narrator","comp":false,"s":[["冰湖长廊",0]]},"ui_room_slope":{"who":"narrator","comp":false,"s":[["雪坡滑梯",0]]},"ui_room_tower":{"who":"narrator","comp":false,"s":[["机关塔楼",0]]},"ui_room_spring":{"who":"narrator","comp":false,"s":[["弹弹雪床",0]]},"ui_room_bunny":{"who":"narrator","comp":false,"s":[["雪兔窝",0]]},"ui_room_floe":{"who":"narrator","comp":false,"s":[["浮冰河",0]]},"ui_room_mu