    "start_hall_1": {"who": "nuan", "say": [{"en": "Hello!", "zh": "你好！"}, "姐姐，我跟着", {"w": "star"}, "的光，找到你啦！"]},
    "start_hall_2": {"who": "frost", "say": ["嗯，你好呀，安娜。我有一点点害羞。"]},
    "start_hall_3": {"who": "nuan", "say": ["不怕不怕！看，到处都是", {"w": "heart"}, "和", {"w": "star"}, "。最后要走到那边的", {"w": "door"}]},
    "start_hall_4": {"who": "frost", "say": ["好呀。我喜欢", {"w": "star"}, "。找齐了宝贝，", {"w": "door"}, "就会开。"]},
    "start_lake_1": {"who": "nuan", "say": ["哇，好大的湖！看，是", {"w": "water"}, "，水好凉呀。"]},
    "start_lake_2": {"who": "frost", "say": ["水里有", {"w": "fish"}, "，小鱼在游呢。"]},
    "start_lake_3": {"who": "nuan", "say": ["姐姐，你能把", {"w": "water"}, "变成", {"w": "ice"}, "吗？这样我就能过去啦。"]},
    "start_lake_4": {"who": "frost", "say": ["我来试试。轻轻地变", {"w": "ice"}, "，别碰到", {"w": "fish"}]},
    "start_slope_1": {"who": "nuan", "say": ["哇，好长的雪坡！这是", {"w": "slide"}, "，大滑梯！"]},
    "start_slope_2": {"who": "frost", "say": ["站在坡上，就会自己往", {"w": "down"}, "滑。越滑越", {"w": "fast"}, "哦。"]},
    "start_slope_3": {"who": "nuan", "say": ["好呀，我们一起", {"w": "slide"}, {"w": "fast"}, {"w": "fast"}, "，抓紧我的手！"]},
    "start_slope_4": {"who": "frost", "say": ["一路往", {"w": "down"}, "滑，坡底有一扇门。边滑边跳，还能拿到高处的星星。"]},
    "start_tower_1": {"who": "nuan", "say": ["哇，好重的", {"w": "gate"}, "！我们怎么过去呢？"]},
    "start_tower_2": {"who": "frost", "say": ["你看，那里有个踏板。用力", {"w": "push"}, "它，", {"w": "gate"}, "就会", {"w": "open"}]},
    "start_tower_3": {"who": "nuan", "say": ["好主意！一个人", {"w": "push"}, "，一个人过", {"w": "gate"}, "。我们分工吧！"]},
    "start_tower_4": {"who": "frost", "say": ["好呀。", {"w": "push"}, "踏板，等", {"w": "gate"}, {"w": "open"}, "，我们就能过去啦。"]},
    "start_spring_1": {"who": "nuan", "say": ["哇，软软的蘑菇！我踩上去试试，", {"w": "jump"}]},
    "start_spring_2": {"who": "frost", "say": ["你踩上去，会飞得好", {"w": "high"}, "呀，一下子就", {"w": "up"}, "到云边啦。"]},
    "start_spring_3": {"who": "nuan", "say": ["我想飞得更", {"w": "high"}, "，去拿那颗星星！"]},
    "start_spring_4": {"who": "frost", "say": ["够不到的话，我变冰块给你当小台阶。你再", {"w": "jump"}, {"w": "up"}, {"w": "up"}]},
    "start_bunny_1": {"who": "nuan", "say": ["呀，是", {"w": "bunny"}, "！小雪兔迷路了，它想回", {"w": "home"}]},
    "start_bunny_2": {"who": "frost", "say": ["轻轻地走过去，", {"w": "bunny"}, "就会跟着我们。我们带它回", {"w": "home"}]},
    "start_bunny_3": {"who": "nuan", "say": ["兔窝门口有", {"w": "carrot"}, "，它们最爱吃", {"w": "carrot"}, "啦！"]},
    "start_bunny_4": {"who": "frost", "say": ["三只", {"w": "bunny"}, "都回了", {"w": "home"}, "，我们才能出发。"]},
    "start_floe_1": {"who": "nuan", "say": ["哇，浮冰在动！它往", {"w": "right"}, "走了，又往", {"w": "left"}, "走回来。"]},
    "start_floe_2": {"who": "frost", "say": ["别着急，", {"w": "wait"}, "一等。等它漂到身边，再跳上去。"]},
