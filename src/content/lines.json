    "mem_m5": {"who": "narrator", "say": ["冬天，艾莎在雪坡上冻出一条长长的冰滑梯。安娜坐着小木盆呼地滑下去，笑声一路飞到山脚。"], "art": "mem_m5"},
    "mem_m2": {"who": "narrator", "say": ["艾莎偷偷给妹妹织了一条红围巾。织呀织，她一边织一边笑，想着安娜收到时的样子。"], "art": "mem_gloves"},
    "mem_m6": {"who": "narrator", "say": ["安娜想摸摸天上的星星，可是够不着。艾莎堆了一张软软的雪床，安娜一跳，弹得高高的，好像真的摸到了星星。"], "art": "mem_m6"},
    "mem_m7": {"who": "narrator", "say": ["下雪天，她们在门口捡到一只小雪兔。安娜用小灯笼给它暖身子，艾莎用冰做了个小窝，它就睡着了。"], "art": "mem_m7"},
    "mem_m8": {"who": "narrator", "say": ["有一年冬天，河面上漂着一块块浮冰。艾莎让一块停下来，姐妹俩坐上去，慢慢漂，一边漂一边数小鱼。"], "art": "mem_m8"},
    "mem_m9": {"who": "narrator", "say": ["艾莎用薄薄的冰片做了一串小风铃。安娜轻轻一碰，叮叮咚咚，她就跟着哼起歌来，艾莎听着听着，笑了。"], "art": "mem_m9"},
    "mem_m4": {"who": "narrator", "say": ["有一天，她们打雪仗，打得太开心了。雪球越滚越大，扑通，两个人一起摔进雪堆，哈哈大笑。"], "art": "mem_fall"},
    "mem_m10": {"who": "narrator", "say": ["小时候最后一场雪里，她们在花园堆了第一个雪人，给它戴上一朵小花。安娜说，明年还要一起堆。"], "art": "mem_m10"},
    "me_frost": {"who": "frost", "say": [{"en": "Hello!", "zh": "你好！"}, "我是艾莎。我最喜欢蓝色，还有亮晶晶的", {"w": "snowflake"}, "。我会变出冰，铺成小路。我的小秘密是，我睡觉的时候，会抱着一只小雪兔玩偶。"]},
    "me_nuan": {"who": "nuan", "say": [{"en": "Hello!", "zh": "你好！"}, "我是安娜。我最喜欢红色，还有圆圆的小灯笼。灯笼暖烘烘的，能让冰变软。我的小秘密是，我最爱吃热乎乎的烤红薯，吃的时候会偷偷哼歌。"]},
    "win": {"who": "narrator", "say": [{"en": "Yay!", "zh": "耶！"}, "花园里开满了花！姐妹俩手拉着手，开心地转圈圈。"]},
    "end": {"who": "narrator", "say": [{"w": "sun"}, "出来啦！冰花都开成了真正的小花，", {"w": "spring"}, "回来了。小时候的雪人戴着帽子，笑眯眯地站在花丛里。艾莎不再害羞，她牵着安娜的手，笑着和大家说", {"en": "Hello!", "zh": "你好！"}], "art": "story_thaw"},
