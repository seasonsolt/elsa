    "start_ballroom_4": {"who": "frost", "say": ["我喜欢这个主意。", {"w": "hat"}, "在哪儿呢？"]},
    "start_garden_1": {"who": "nuan", "say": ["哇，好大的花园！可是", {"w": "flower"}, "都睡着了，冰冰的。"]},
    "start_garden_2": {"who": "frost", "say": ["灯笼的光是", {"w": "warm"}, "的。花儿碰到它，就会醒过来。"]},
