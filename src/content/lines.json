  "lines": {
    "p1": {"who": "narrator", "say": ["艾莎会变魔法，手一挥，就飘起亮晶晶的雪花。可是她很害羞，不爱让别人看见。"], "art": "story_prologue"},
    "p2": {"who": "narrator", "say": ["丰收节那天，艾莎一紧张，夏天下起了大雪。她害羞地躲进了山上的冰堡。"], "art": "story_winter"},
    "p3": {"who": "narrator", "say": ["安娜提着小灯笼，上山去找姐姐。她们要一起，把小时候的雪人堆起来。"], "art": "key"},
    "ch_hall": {"who": "narrator", "say": ["安娜在冰堡的大厅里，找到了害羞的姐姐。"], "art": "bg0"},
    "ch_lake": {"who": "narrator", "say": ["冰堡后面有一片大湖，小鱼在水里游来游去。"], "art": "bg1"},
    "ch_slope": {"who": "narrator", "say": ["冰堡里有一条长长的雪坡，像一个大滑梯。呼——滑下去！"], "art": "bg_slope"},
    "ch_tower": {"who": "narrator", "say": ["塔楼里有一扇很重的铁门，要两个人一起想办法。"], "art": "bg2"},
    "ch_spring": {"who": "narrator", "say": ["雪地里长满了软软的蘑菇，踩上去，弹——弹到半空里去！"], "art": "bg_spring"},
    "ch_bunny": {"who": "narrator", "say": ["雪地里有三只小雪兔迷路了，我们带它们回家吧。"], "art": "bg_bunny"},
    "ch_floe": {"who": "narrator", "say": ["河面上漂着一块块浮冰，一会儿往左，一会儿往右。"], "art": "bg_floe"},
    "ch_music": {"who": "narrator", "say": ["台阶一级一级，闪着彩色的光。踩一踩，它们会唱歌！"], "art": "bg_music"},
    "ch_ballroom": {"who": "narrator", "say": ["舞厅里滚着好多大雪球，我们来堆雪人吧！"], "art": "bg3"},
    "ch_garden": {"who": "narrator", "say": ["冰堡的后花园里，冰花还在睡觉。我们用温暖的光，叫醒它们。"], "art": "bg_garden"},
    "learn_heart": {"who": "narrator", "say": ["这一关我们要找", {"w": "heart"}, "。看，", {"w": "heart"}, "就是爱心。跟我说：", {"w": "heart"}]},
    "learn_star": {"who": "narrator", "say": ["还有", {"w": "star"}, "。看，", {"w": "star"}, "就是星星。跟我说：", {"w": "star"}]},
    "learn_door": {"who": "narrator", "say": ["最后是", {"w": "door"}, "。看，", {"w": "door"}, "就是门。跟我说：", {"w": "door"}]},
    "learn_water": {"who": "narrator", "say": ["这一关有一片大湖，湖里是", {"w": "water"}, "。看，", {"w": "water"}, "就是水。跟我说：", {"w": "water"}]},
    "learn_ice": {"who": "narrator", "say": ["艾莎的魔法，能把水变成", {"w": "ice"}, "。看，", {"w": "ice"}, "就是冰。跟我说：", {"w": "ice"}]},
    "learn_fish": {"who": "narrator", "say": ["水里还住着", {"w": "fish"}, "。看，", {"w": "fish"}, "就是小鱼。跟我说：", {"w": "fish"}]},
    "learn_slide": {"who": "narrator", "say": ["这一关有一条大雪坡，我们要玩", {"w": "slide"}, "。看，", {"w": "slide"}, "就是滑滑梯。跟我说：", {"w": "slide"}]},
    "learn_fast": {"who": "narrator", "say": ["从坡上滑下来的时候，会变得很", {"w": "fast"}, "。看，", {"w": "fast"}, "就是快。跟我说：", {"w": "fast"}]},
    "learn_down": {"who": "narrator", "say": ["最后是", {"w": "down"}, "。看，", {"w": "down"}, "就是向下。跟我说：", {"w": "down"}]},
    "learn_push": {"who": "narrator", "say": ["这一关要用到", {"w": "push"}, "。看，", {"w": "push"}, "就是推。跟我说：", {"w": "push"}]},
    "learn_open": {"who": "narrator", "say": ["推了以后，门会", {"w": "open"}, "。看，", {"w": "open"}, "就是打开。跟我说：", {"w": "open"}]},
    "learn_gate": {"who": "narrator", "say": ["这里有一扇铁门，叫", {"w": "gate"}, "。看，", {"w": "gate"}, "就是铁闸门。跟我说：", {"w": "gate"}]},
    "learn_jump": {"who": "narrator", "say": ["这一关有软软的蘑菇，我们要练习", {"w": "jump"}, "。看，", {"w": "jump"}, "就是跳。跟我说：", {"w": "jump"}]},
    "learn_up": {"who": "narrator", "say": ["踩上蘑菇，就会往", {"w": "up"}, "飞。看，", {"w": "up"}, "就是向上。跟我说：", {"w": "up"}]},
    "learn_high": {"who": "narrator", "say": ["还会飞得很", {"w": "high"}, "。看，", {"w": "high"}, "就是高。跟我说：", {"w": "high"}]},
    "learn_bunny": {"who": "narrator", "say": ["这一关有三只迷路的", {"w": "bunny"}, "。看，", {"w": "bunny"}, "就是小雪兔。跟我说：", {"w": "bunny"}]},
    "learn_home": {"who": "narrator", "say": ["我们要送它们回", {"w": "home"}, "。看，", {"w": "home"}, "就是家。跟我说：", {"w": "home"}]},
    "learn_carrot": {"who": "narrator", "say": ["兔窝门口，有它们最爱吃的", {"w": "carrot"}, "。看，", {"w": "carrot"}, "就是胡萝卜。跟我说：", {"w": "carrot"}]},
    "learn_left": {"who": "narrator", "say": ["河上的浮冰，一会儿往", {"w": "left"}, "走。看，", {"w": "left"}, "就是左。跟我说：", {"w": "left"}]},
    "learn_right": {"who": "narrator", "say": ["一会儿又往", {"w": "right"}, "走。看，", {"w": "right"}, "就是右。跟我说：", {"w": "right"}]},
    "learn_wait": {"who": "narrator", "say": ["想上浮冰，要先", {"w": "wait"}, "。看，", {"w": "wait"}, "就是等一等。跟我说：", {"w": "wait"}]},
    "learn_red": {"who": "narrator", "say": ["这一关的台阶是彩色的，第一种是", {"w": "red"}, "。看，", {"w": "red"}, "就是红色。跟我说：", {"w": "red"}]},
    "learn_yellow": {"who": "narrator", "say": ["还有", {"w": "yellow"}, "。看，", {"w": "yellow"}, "就是黄色。跟我说：", {"w": "yellow"}]},
    "learn_blue": {"who": "narrator", "say": ["最后是", {"w": "blue"}, "。看，", {"w": "blue"}, "就是蓝色。跟我说：", {"w": "blue"}]},
    "learn_snowman": {"who": "narrator", "say": ["我们要堆起", {"w": "snowman"}, "。看，", {"w": "snowman"}, "就是雪人。跟我说：", {"w": "snowman"}]},
    "learn_ball": {"who": "narrator", "say": ["要用大大的", {"w": "ball"}, "。看，", {"w": "ball"}, "就是球，雪球的球。跟我说：", {"w": "ball"}]},
    "learn_hat": {"who": "narrator", "say": ["雪人还要戴", {"w": "hat"}, "。看，", {"w": "hat"}, "就是帽子。跟我说：", {"w": "hat"}]},
    "learn_flower": {"who": "narrator", "say": ["这一关是花园，园子里睡着许多", {"w": "flower"}, "。看，", {"w": "flower"}, "就是花。跟我说：", {"w": "flower"}]},
    "learn_warm": {"who": "narrator", "say": ["灯笼的光暖烘烘的，是", {"w": "warm"}, "。看，", {"w": "warm"}, "就是温暖。跟我说：", {"w": "warm"}]},
    "learn_spring": {"who": "narrator", "say": ["温暖的风一吹，", {"w": "spring"}, "就来啦。看，", {"w": "spring"}, "就是春天。跟我说：", {"w": "spring"}]},
